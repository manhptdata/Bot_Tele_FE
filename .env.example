# 1. Tiêu đề tab trình duyệt
# - Trên Production / Bản thật: "BotShop Admin"
# - Trên Preview / Bản test: "[TEST] BotShop Admin"
VITE_APP_TITLE="BotShop Admin"

# 2. Đường dẫn Backend API
